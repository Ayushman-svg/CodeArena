# ---------- Server ----------
NODE_ENV=development
PORT=5000
# The only origin allowed by CORS (the React dev server)
CLIENT_URL=http://localhost:5173
REQUEST_BODY_LIMIT=256kb

# ---------- Database ----------
# Local MongoDB or an Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/codearena

# ---------- Auth ----------
# At least 32 characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# ---------- Rate limits ----------
# Login and register attempts per 15 minutes per IP
AUTH_RATE_LIMIT_MAX=10
# Runs and submits per user per minute
SUBMIT_RATE_LIMIT_PER_MIN=10

# ---------- Submissions ----------
MAX_SOURCE_CHARS=50000

# ---------- Code execution (Judge0, used from Phase 4) ----------
# Keep Judge0 private: only this API server should be able to reach it
JUDGE0_URL=http://localhost:2358
# Sent as the X-Auth-Token header (set the same token in your Judge0 config)
JUDGE0_AUTH_TOKEN=
JUDGE0_POLL_INTERVAL_MS=1000
JUDGE0_POLL_TIMEOUT_MS=30000